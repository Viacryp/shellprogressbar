<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="viacryp" value="https://nuget.pkg.github.com/Viacryp/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="viacryp"><package pattern="Viacryp.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <viacryp>
      <add key="Username" value="%GH_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%GH_PACKAGES_TOKEN%" />
    </viacryp>
  </packageSourceCredentials>
</configuration>